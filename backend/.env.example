# Copy to backend/.env — .env is gitignored.

# Server-side Gemini key. Optional: if unset, callers must send their own key
# in the x-gemini-api-key header (the extension's bring-your-own-key path).
GEMINI_API_KEY=

PORT=3000

# Comma-separated CORS allowlist. Empty = only same-origin/no-origin callers.
# Find your extension id at chrome://extensions/ with Developer Mode on.
# ALLOWED_ORIGINS=chrome-extension://your-extension-id-here

# Fixed-window rate limit for /api/parse-resume.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
