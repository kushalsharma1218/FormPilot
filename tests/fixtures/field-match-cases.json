{
  "_comment": "Evaluation corpus for label -> profile-key matching. `expect: null` means the matcher MUST NOT fill this field; those cases are what precision is measured on, and a wrong fill is worse than an empty one because auto-learn persists it.",
  "profile": {
    "firstName": "Kushal",
    "lastName": "Sharma",
    "email": "kushal@example.com",
    "phone": "555-111-2222",
    "linkedin": "https://linkedin.com/in/kushal",
    "github": "https://github.com/kushal",
    "portfolio": "https://kushal.dev",
    "address": "12 Example Street",
    "city": "Dubai",
    "state": "Dubai",
    "zipcode": "00000",
    "country": "United Arab Emirates",
    "currentCompany": "DP World",
    "currentTitle": "Group Software Engineer",
    "totalYearsExperience": "5",
    "summary": "Builder of reliable systems.",
    "salary": "200000",
    "noticePeriod": "30"
  },
  "cases": [
    { "label": "First Name", "tag": "input", "expect": "firstName" },
    { "label": "Last Name", "tag": "input", "expect": "lastName" },
    { "label": "Email", "tag": "input", "type": "email", "expect": "email" },
    { "label": "Email Address", "tag": "input", "type": "email", "expect": "email" },
    { "label": "Phone", "tag": "input", "type": "tel", "expect": "phone" },
    { "label": "Mobile Number", "tag": "input", "type": "tel", "expect": "phone" },
    { "label": "LinkedIn", "tag": "input", "expect": "linkedin" },
    { "label": "LinkedIn Profile URL", "tag": "input", "expect": "linkedin" },
    { "label": "GitHub", "tag": "input", "expect": "github" },
    { "label": "Portfolio", "tag": "input", "expect": "portfolio" },
    { "label": "Website", "tag": "input", "expect": "portfolio" },
    { "label": "Current Company", "tag": "input", "expect": "currentCompany" },
    { "label": "Employer", "tag": "input", "expect": "currentCompany" },
    { "label": "Current Title", "tag": "input", "expect": "currentTitle" },
    { "label": "Job Title", "tag": "input", "expect": "currentTitle" },
    { "label": "Total years of experience", "tag": "input", "type": "number", "expect": "totalYearsExperience" },
    { "label": "Years of Experience", "tag": "input", "type": "number", "expect": "totalYearsExperience" },
    { "label": "City", "tag": "input", "expect": "city" },
    { "label": "State", "tag": "select", "expect": "state" },
    { "label": "Country", "tag": "select", "expect": "country" },
    { "label": "Zip / Postal Code", "tag": "input", "expect": "zipcode" },
    { "label": "Street Address", "tag": "input", "expect": "address" },
    { "label": "Desired Salary", "tag": "input", "expect": "salary" },
    { "label": "Summary", "tag": "textarea", "expect": "summary" },

    { "label": "Current Company Notice Period (number of days)", "tag": "input", "type": "number", "expect": "noticePeriod",
      "note": "Live corruption: /company|employer/ matched the modifier and filled the employer NAME into a field measured in days." },
    { "label": "Notice Period", "tag": "input", "type": "number", "expect": "noticePeriod" },
    { "label": "Notice period in days", "tag": "input", "type": "number", "expect": "noticePeriod" },

    { "label": "How many years of experience do you have with React?", "tag": "input", "type": "number", "expect": null,
      "note": "Skill-specific experience must not receive TOTAL years." },
    { "label": "Years of experience with Kubernetes", "tag": "input", "type": "number", "expect": null },
    { "label": "Why do you want to work at this company?", "tag": "textarea", "expect": null },
    { "label": "What is your current company culture like?", "tag": "textarea", "expect": null },
    { "label": "Company size you prefer", "tag": "select", "expect": null },
    { "label": "How did you hear about us?", "tag": "select", "expect": null },
    { "label": "Preferred pronouns", "tag": "input", "expect": null },
    { "label": "Emergency contact name", "tag": "input", "expect": null },
    { "label": "Referrer's email", "tag": "input", "type": "email", "expect": null },
    { "label": "Manager's phone number", "tag": "input", "type": "tel", "expect": null },
    { "label": "Password", "tag": "input", "type": "password", "expect": null },
    { "label": "Confirm Password", "tag": "input", "type": "password", "expect": null },
    { "label": "Are you comfortable with a hybrid work model?", "tag": "select", "expect": null },
