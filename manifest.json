{
  "manifest_version": 3,
  "name": "HireFlow AI — Ultimate Career Copilot",
  "version": "2.2.0",
  "description": "Your AI-powered application powerhouse. Automate forms, tailor resumes instantly, and track every job with smarter intelligence.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "identity"
  ],
  "oauth2": {
    "client_id": "1054554783896-cb8dnl7bmq2kag765039iao8n1jd5ubr.apps.googleusercontent.com",
    "scopes": [
      "email",
      "profile",
      "openid"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/field-utils.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard/pdf.worker.min.js",
        "dashboard/pdf.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
