{
  "manifest_version": 3,
  "key": "",
  "name": "FormPilot AI — Smart Application Autofill",
  "version": "2.2.0",
  "description": "Elegant AI-powered autofill for job applications and complex forms. Learn once, fill everywhere.",
  "permissions": [
    "storage",
    "tabs",
    "identity"
  ],
  "oauth2": {
    "client_id": "1054554783896-ni6tmuo8fbejunqskf6lj1l3gq7jdaal.apps.googleusercontent.com",
    "scopes": [
      "email",
      "profile",
      "openid"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/field-utils.js",
        "lib/field-ontology.js",
        "lib/value-vocab.js",
        "lib/field-match.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/plus-jakarta-sans-latin-wght-normal.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'"
  }
}
