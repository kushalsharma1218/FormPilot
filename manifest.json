{
  "manifest_version": 3,
  "name": "Job Autofill — AI Copilot",
  "version": "2.2.0",
  "description": "AI-powered job application assistant: autofill, resume tailoring, match scoring, interview prep & application tracking. Works with free on-device AI — no API key needed!",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "aiLanguageModelOriginTrial"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard/pdf.worker.min.js",
        "dashboard/pdf.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}